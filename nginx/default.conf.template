# The site is static files (Astro wrote one per page: /legal is legal.html), plus one door to Hodi: its sign-up
# routes, which the sign-up forms call on the site's own address. nginx's image fills in ${HODI_URL} at start.
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;

  # Behind the reverse proxy: a redirect keeps the visitor's own host and port.
  absolute_redirect off;
  server_tokens off;

  # The reverse proxy in front (on this machine or network) names the visitor: Hodi's limits count per visitor, not
  # per proxy.
  set_real_ip_from 10.0.0.0/8;
  set_real_ip_from 172.16.0.0/12;
  set_real_ip_from 192.168.0.0/16;
  set_real_ip_from 127.0.0.1;
  set_real_ip_from fc00::/7;
  real_ip_header X-Forwarded-For;
  real_ip_recursive on;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml application/xml text/plain;
  gzip_min_length 1024;

  # Each location repeats the security headers: nginx drops the outer ones where a location adds its own.
  # Files whose name carries their hash never change: a year in the cache.
  location ^~ /_astro/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
  }

  # The demos, fonts and pictures change only with a deploy: a day, then the browser asks again.
  location ~ ^/(landing|fonts)/ {
    add_header Cache-Control "public, max-age=86400";
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
  }

  # Hodi's sign-up routes: same origin for the browser, so no CORS and Hodi's Sec-Fetch-Site check passes.
  # Docker's resolver finds Hodi at each request: the site starts even while Hodi is down.
  location ^~ /api/public/plugins/village/ {
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $hodi ${HODI_URL};
    proxy_pass $hodi;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    client_max_body_size 64k;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options nosniff always;
  }

  # Nothing else of Hodi's API is the site's.
  location /api/ {
    return 404;
  }

  # Pages change with each deploy: the browser asks again, and gets 304 when nothing moved. /en is en.html.
  location / {
    add_header Cache-Control "no-cache";
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;
    try_files $uri $uri.html $uri/ =404;
  }

  # An unknown address under /en gets the English 404.
  location /en/ {
    add_header Cache-Control "no-cache";
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;
    try_files $uri $uri.html $uri/ =404;
    error_page 404 /en/404.html;
  }

  # The older address of a page with a slash: the same page, without it.
  location ~ ^(.+)/$ {
    return 301 $1;
  }

  error_page 404 /404.html;
}
